# Wondersale Storefront Environment Variables
# Market: India (Bhopal Store & Nationwide Shipping)
# Currency: INR (Prices in integer paise)

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wondersale?schema=public

# Session Authentication
NEXTAUTH_SECRET=dev_super_secret_session_key_32bytes_min!

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# SMS OTP Provider (console | msg91 | twilio)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Object Storage & CDN (S3 Compatible: MinIO / AWS S3 / Cloudflare R2)
S3_BUCKET=wondersale-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1

# Initial Admin Credentials
ADMIN_EMAIL=admin@wondersale.in
ADMIN_PASSWORD=Admin@Wondersale123#
