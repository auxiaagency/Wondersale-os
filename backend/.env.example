# ==============================================================================
# WONDERSALE SYSTEM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the backend folder and fill in your actual values.
# NEVER commit your `.env` file to GitHub or share it publicly!
# ==============================================================================

# Environment Mode: 'development' or 'production'
DJANGO_ENV=development
DJANGO_DEBUG=True

# Django Security: Long, cryptographically random key (mandatory in production)
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production

# Allowed Hosts & Domains (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,wonder.sale,api.wonder.sale

# Admin URL Prefix (Move off default /admin/ in production, e.g. 'control-hub/')
ADMIN_URL_PREFIX=admin/

# Initial Bootstrap Owner & Store (Used on first launch if not already created)
# DEFAULT_OWNER_ID=Salman
# DEFAULT_OWNER_PASSWORD=change_this_to_a_strong_password
# DEFAULT_STORE_NAME=Bhopal Plaza
# DEFAULT_STORE_PHONE=9755004996
# DEFAULT_STORE_GST=23ANGPK5446D2Z8

# Database Configuration (PostgreSQL; if omitted, defaults to local db.sqlite3)
# POSTGRES_DB=wondersale
# POSTGRES_USER=wondersale_user
# POSTGRES_PASSWORD=your_secure_db_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_CONNECT_TIMEOUT=10
# POSTGRES_SSLMODE=require

# CORS & CSRF Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://os.wonder.sale
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://os.wonder.sale

# SSL & Security Redirects (Production defaults to True when DJANGO_DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Google Gemini Multi-Key Pool (Comma-separated for automated failover & rate-limit rotation)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Optional: Meta WhatsApp Cloud API (Official WhatsApp Business integration)
# META_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
# META_WHATSAPP_ACCESS_TOKEN=your_system_user_permanent_access_token_here
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
# META_WHATSAPP_RETURN_TEMPLATE_NAME=return_receipt

# WhatsApp Cloud API Rate Limiting & Billing Protections
MAX_DAILY_WHATSAPP_MESSAGES=5000
ORDER_RESEND_COOLDOWN_SECONDS=60
MAX_MESSAGES_PER_PHONE_PER_HOUR=10
META_API_TIMEOUT_SECONDS=10

# Logging
DJANGO_LOG_LEVEL=INFO
